# Copy to deploy/lightsail/lightsail.env and fill in. That file is git-ignored: never commit it.

# AWS
AWS_REGION=us-east-1
SERVICE_NAME=qem-bench
# Lightsail container power: nano | micro | small | medium | large | xlarge  (medium recommended)
SERVICE_POWER=medium

# MongoDB Atlas connection string (Database > Connect > Drivers). Include the user and password.
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=qem-bench
DB_NAME=qem_bench

# Owner password for the "Run Simulations" tab, and the token-signing secret.
# Generate the secret with:  python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_PASSWORD=change-me-to-a-long-password
JWT_SECRET=paste-64-hex-characters-here

# Public address(es) of the site, comma-separated. Start with the Lightsail URL; add your domain later.
CORS_ORIGINS=https://qem-bench.xxxxxxxxxxxx.us-east-1.cs.amazonlightsail.com
