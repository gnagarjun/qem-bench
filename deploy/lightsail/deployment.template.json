{
  "containers": {
    "app": {
      "image": ":qem-bench.app.latest",
      "ports": { "8000": "HTTP" },
      "environment": {}
    }
  },
  "publicEndpoint": {
    "containerName": "app",
    "containerPort": 8000,
    "healthCheck": {
      "path": "/api/health",
      "successCodes": "200-299",
      "intervalSeconds": 30,
      "timeoutSeconds": 5,
      "healthyThreshold": 2,
      "unhealthyThreshold": 3
    }
  }
}
